# Lifepizza — copy to .env.local and fill real values

# Database
MONGODB_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/cravebox
MONGODB_DB_NAME=cravebox

# Auth
NEXTAUTH_SECRET=generate-a-long-random-string
NEXTAUTH_URL=http://localhost:3000
# Used only by scripts/ensure-admin.ts to create/promote admin (no public admin signup)
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=change-me-strong-password

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Razorpay (use live keys in production)
RAZORPAY_KEY_ID=rzp_test_xxx
RAZORPAY_KEY_SECRET=xxx
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxx

# Cloudinary
CLOUDINARY_CLOUD_NAME=xxx
CLOUDINARY_API_KEY=xxx
CLOUDINARY_API_SECRET=xxx

# Demo OTP when WhatsApp/SMS providers are not configured (local/dev only)
ALLOW_DEMO_OTP=true

# WhatsApp OTP (preferred) + SMS fallback via Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# SMS fallback via MSG91 (India)
MSG91_AUTH_KEY=
MSG91_SENDER=LIFEPZ
# MSG91_TEMPLATE_ID=
